{
  "id": "kimi",
  "kind": "plugin",
  "version": "1.0.11",
  "label": "Kimi",
  "description": "Kimi API (Moonshot Open Platform) for Settings \u2192 LLMs. Install from Store \u2192 Gateways, then enable to show Kimi under Providers & Keys.",
  "min_app_version": "1.2.45",
  "default_enabled": true,
  "secret_keys": [
    "kimi"
  ],
  "contributes": {
    "llm.providers": [
      {
        "id": "kimi",
        "label": "Kimi",
        "kind": "secret",
        "secret_key": "kimi",
        "order": 45
      }
    ],
    "walkthrough": {
      "id": "kimi",
      "title": "Set up Kimi",
      "auto_start": "first_enable",
      "settings_tab": "LLMs",
      "steps": [
        {
          "target": "settings.llms.provider.kimi",
          "title": "Open Kimi",
          "body": "Press the Kimi row in this table. The page slides open so you can paste your API key.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.key",
          "title": "API key",
          "body": "Paste your Moonshot/Kimi API key from platform.kimi.ai.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.save",
          "title": "Test & Save",
          "body": "Press Test & Save after you paste a key.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.back",
          "title": "Back",
          "body": "Press Back to return to the provider list.",
          "advance": "require_click",
          "mode": "rect"
        }
      ]
    },
    "automations": {
      "nodes": [
        {
          "id": "kimi.complete",
          "label": "Kimi complete",
          "group": "Kimi",
          "description": "One-shot prompt through the Kimi gateway. Writes text onto the run.",
          "config_fields": [
            {
              "id": "prompt",
              "label": "Prompt",
              "type": "textarea"
            },
            {
              "id": "model",
              "label": "Model",
              "type": "model",
              "provider": "kimi"
            }
          ]
        }
      ],
      "templates": [
        {
          "id": "kimi-complete",
          "label": "Kimi complete",
          "icon": "\u2728",
          "systems": [
            "pipeline"
          ],
          "description": "Chat prompt through Kimi, then finish.",
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Chat",
                "description": ""
              },
              {
                "id": "c",
                "type": "kimi.complete",
                "x": 280,
                "y": 80,
                "config": {},
                "label": "Complete",
                "description": ""
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 520,
                "y": 80,
                "config": {},
                "label": "Finish",
                "description": ""
              }
            ],
            "edges": [
              {
                "source": "s",
                "target": "c",
                "kind": "main"
              },
              {
                "source": "c",
                "target": "f",
                "kind": "main"
              }
            ]
          }
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
